{
  "name": "redraft",
  "productName": "Redraft",
  "version": "1.0.0",
  "description": "Edit scanned study notes with a mouse: layers, smooth brushes, text, cover & rewrite, replay.",
  "main": "main.cjs",
  "author": "Redraft",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node test/e2e/run.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/indie-flower": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "jszip": "^3.10.1",
    "mp4-muxer": "^5.1.3",
    "opentype.js": "^1.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "perfect-freehand": "^1.2.2",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.65.1"
  },
  "type": "module",
  "build": {
    "appId": "app.redraft.notes",
    "productName": "Redraft",
    "copyright": "MIT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.md",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdf-lib/es/**",
      "!node_modules/pdf-lib/cjs/**",
      "!node_modules/pdf-lib/src/**",
      "!node_modules/@fontsource/*/scss/**",
      "!node_modules/@fontsource/*/files/*-{korean,cyrillic,cyrillic-ext,greek,greek-ext,vietnamese,math,symbols}-*",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**",
      "!node_modules/tesseract.js/src/**",
      "!node_modules/opentype.js/src/**",
      "!node_modules/opentype.js/dist/opentype.module.js",
      "!node_modules/opentype.js/dist/opentype.js",
      "!node_modules/tesseract.js-core/tesseract-core.{js,wasm,wasm.js}",
      "!node_modules/tesseract.js-core/tesseract-core-simd.{js,wasm,wasm.js}"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "redraft",
        "name": "Redraft Project",
        "description": "Redraft notes project",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Redraft"
    }
  }
}
